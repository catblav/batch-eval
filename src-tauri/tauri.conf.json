{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "黑猫-自动评测台",
  "version": "0.1.4",
  "identifier": "com.batcheval.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "黑猫-自动评测台",
        "width": 1336,
        "height": 826,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/auto-iterate/script_auto_iterate.py": "auto-iterate/script_auto_iterate.py",
      "resources/auto-iterate/guide_agent.md": "auto-iterate/guide_agent.md",
      "resources/auto-iterate/guide_user.md": "auto-iterate/guide_user.md"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "startMenuFolder": "黑猫-自动评测台",
        "installerHooks": "nsis/installer.nsh"
      }
    }
  }
}
